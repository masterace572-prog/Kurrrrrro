# ---------------------------------------------------------------------------
# KURO PANEL — environment
# Copy to .env.local for local dev, or paste into Vercel → Settings → Env Vars
# ---------------------------------------------------------------------------

# Postgres connection string.
# Supabase: Project → Settings → Database → Connection string → "Connection pooling"
#           (port 6543). Use the session/transaction pooler for serverless.
# Neon:     Dashboard → Connection string (add ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# Random 32+ char secret used to sign session cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Public origin of the deployment. Used for the endpoint hints in the UI and
# for the curl examples. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# Salt the loader uses to verify the token it gets back.
# Must match the constant compiled into the APK (main.cpp). Do not change
# unless you also rebuild the loader.
LOADER_LICENSE_SALT=Vm8Lk7Uj2JmsjCPVPVjrLa7zgfx3uz9E

# --- optional -----------------------------------------------------------------

# Version text served by /api/version when no lib release is published yet.
FALLBACK_LIB_VERSION=1.0

# Max size of a lib zip uploaded through the panel, in MB.
# Vercel rejects request bodies over 4.5 MB, so keep this at 4 or lower there.
# Bigger zips: publish an external URL (GitHub Releases) instead.
MAX_LIB_UPLOAD_MB=4

# Force SSL off for a local database
# PGSSL=disable

# Connection pool size per serverless instance (default 3, max 1 on free Supabase)
# PGPOOL_MAX=3
