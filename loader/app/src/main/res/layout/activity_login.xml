<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="30dp"
            android:paddingEnd="26dp"
            android:paddingBottom="86dp">

            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="78dp">
                <ImageView
                    android:id="@+id/logoGlow"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:alpha="0"
                    android:contentDescription="@string/app_name" />
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_transparent" />
            </FrameLayout>

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="XLOX LOADER"
                android:textColor="#F4F4F5"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:letterSpacing="0.2"
                android:text="SECURE ACCESS"
                android:textColor="#315FE5"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_reference_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/userkey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Enter access key"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="#F4F4F5"
                        android:textColorHint="#77777F"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/eyeToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.7"
                        android:clickable="true"
                        android:contentDescription="Show or hide key"
                        android:focusable="true"
                        android:src="@drawable/ic_eye"
                        app:tint="#D8D8DE" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_blue_action"
                    android:stateListAnimator="@null"
                    android:text="Login"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pasteKey"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="9dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Paste Key"
                    android:textColor="#315FE5"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/buyNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Don't Have a Key? Buy Now"
                    android:textColor="#77777F"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:letterSpacing="0.2"
        android:text="SYSTEM READY"
        android:textColor="#3E3E45"
        android:textSize="10sp" />
</FrameLayout>
