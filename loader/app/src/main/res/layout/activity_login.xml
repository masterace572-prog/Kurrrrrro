<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_void">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_transparent" />

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.14"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.24"
                android:text="SECURE ACCESS"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_reference_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="ACCESS KEY"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_reference_input"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/userkey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Paste your key"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_dim"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/eyeToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.7"
                        android:clickable="true"
                        android:contentDescription="Show or hide key"
                        android:focusable="true"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_primary_action"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Continue"
                    android:textAllCaps="false"
                    android:textColor="@color/surface_void"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pasteKey"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Paste from clipboard"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:minHeight="18dp"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- The update gate. Covers the screen and has no dismiss: an update is
         required, so the only way on is through it. -->
    <LinearLayout
        android:id="@+id/gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_void"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/gateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update available"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gateDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="A new version is required to continue."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/gateProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/line"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/gateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_primary_action"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Update now"
            android:textAllCaps="false"
            android:textColor="@color/surface_void"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:text="Your key is bound to this device"
        android:textColor="@color/text_faint"
        android:textSize="10sp" />
</FrameLayout>
