<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="34dp"
    android:paddingEnd="34dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_transparent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.08"
        android:text="@string/app_name"
        android:textColor="#F4F4F5"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:letterSpacing="0.25"
        android:text="SECURE ACCESS"
        android:textColor="#85858D"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:indeterminateTint="#315FE5"
        android:max="100"
        android:progress="0"
        android:progressTint="#315FE5" />

    <TextView
        android:id="@+id/splashStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Checking for updates…"
        android:textColor="#F4F4F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/splashPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#315FE5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splashDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#85858D"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/splashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/splashRetry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_orange_action"
            android:stateListAnimator="@null"
            android:text="RETRY"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/splashRedownload"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_reference_card"
            android:stateListAnimator="@null"
            android:text="REDOWNLOAD UPDATE"
            android:textColor="#F4F4F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/splashRestart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_red_action"
            android:stateListAnimator="@null"
            android:text="RESTART APP"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
