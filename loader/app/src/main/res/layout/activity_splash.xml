<?xml version="1.0" encoding="utf-8"?>
<!--
  Startup gate. One centred column: mark, name, one progress line, one status
  line, and — only when something went wrong — three quiet buttons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp"
        >

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_mark" />
    </FrameLayout>

    <TextView
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.16"
        android:text="@string/app_name" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.22"
        android:text="@string/tagline" />

    <ProgressBar
        android:id="@+id/splashProgress"
        style="@style/Widget.Progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="44dp"
        android:indeterminate="false"
        android:progress="0" />

    <TextView
        android:id="@+id/splashStatus"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/checking_for_updates" />

    <TextView
        android:id="@+id/splashPercent"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="" />

    <TextView
        android:id="@+id/splashDetail"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text=""
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/splashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/splashRetry"
            style="@style/Widget.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/retry" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/splashRedownload"
            style="@style/Widget.Button.Quiet"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/redownload"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/splashRestart"
            style="@style/Widget.Button.Link"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/restart_app" />
    </LinearLayout>

</LinearLayout>
