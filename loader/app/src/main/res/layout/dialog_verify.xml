<?xml version="1.0" encoding="utf-8"?>
<!--
  The "checking your key" dialog: one row — ring, then the step — and the key
  quoted back masked underneath. Its width is set by LogAct (86% of the screen,
  capped at 340dp) so it reads as a small card in the middle, never as a band
  across the display.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:minWidth="260dp"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ProgressBar
                android:id="@+id/verifySpinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/text_secondary" />

            <ImageView
                android:id="@+id/verifyDone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/success"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/verifyStep"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/verify_step_panel" />
    </LinearLayout>

    <TextView
        android:id="@+id/verifyKey"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="8dp"
        android:ellipsize="middle"
        android:letterSpacing="0.08"
        android:singleLine="true"
        android:text="" />
</LinearLayout>
