<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="76dp">

            <LinearLayout
                android:id="@+id/brandHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/logoFrame"
                    android:layout_width="58dp"
                    android:layout_height="58dp">
                    <ImageView
                        android:id="@+id/logoGlow"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:alpha="0"
                        android:contentDescription="@string/app_name" />
                    <ImageView
                        android:id="@+id/mainLogo"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_transparent" />
                </FrameLayout>
                <TextView
                    android:id="@+id/dashboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="XLOX LOADER"
                    android:textColor="#F4F4F5"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.2"
                    android:text="SECURE ACCESS"
                    android:textColor="#315FE5"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_reference_card"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp"
                android:paddingBottom="13dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subscription "
                        android:textColor="#315FE5"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:textColor="#E4E4E8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="STATUS"
                        android:textColor="#85858D"
                        android:textSize="11sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expiry Date"
                        android:textColor="#85858D"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/subscriptionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Active"
                        android:textColor="#25C779"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/expiryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="--"
                        android:textColor="#F1F1F3"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:background="#34343A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME REMAINING"
                    android:textColor="#85858D"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/timeRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--"
                    android:textColor="#FF9800"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deviceStatusRow"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reference_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingEnd="7dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Device"
                        android:textColor="#85858D"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/deviceValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Android device"
                        android:textColor="#F1F1F3"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reference_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingEnd="7dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="#85858D"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/deviceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Safe"
                        android:textColor="#315FE5"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/startBgmi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_orange_action"
                android:stateListAnimator="@null"
                android:text="LAUNCH GAME"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/statusToggle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_reference_card"
                android:gravity="center_vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/statusLoader"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminateTint="#315FE5"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/statusErrorIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:text="STATUS"
                    android:textColor="#F1F1F3"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/statusToggleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY"
                    android:textColor="#315FE5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/downloadBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_reference_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/downloadProgressBar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:indeterminateTint="#315FE5" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/downloadStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparing..."
                        android:textColor="#F1F1F3"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Please wait while we finish"
                        android:textColor="#85858D"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/percentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAIT"
                    android:textColor="#315FE5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/loadingCursor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/legacyControls"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/startText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/actionIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/packageName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/gameStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/appVersionText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/keyTimeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <include android:id="@+id/daysBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/hoursBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/minutesBox" layout="@layout/item_time_box" />
                    <include android:id="@+id/secondsBox" layout="@layout/item_time_box" />
                </LinearLayout>
                <LinearLayout android:id="@+id/fbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/startFB" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/obbButton" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/restartButton" android:layout_width="1dp" android:layout_height="1dp" android:text="CLEAR DATA" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/systemReady"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:letterSpacing="0.16"
        android:text="SYSTEM READY"
        android:textColor="#3E3E45"
        android:textSize="10sp" />
</FrameLayout>
