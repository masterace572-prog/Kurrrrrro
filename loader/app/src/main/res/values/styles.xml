<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================= theme -->

    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="colorAccent">@color/action</item>
        <item name="colorPrimary">@color/action</item>
        <item name="colorControlHighlight">#14FFFFFF</item>
        <item name="colorControlActivated">@color/text_primary</item>
        <item name="alertDialogTheme">@style/DarkAlertDialogStyle</item>
        <item name="materialAlertDialogTheme">@style/DarkAlertDialogStyle</item>
    </style>

    <!-- ====================================================== typography -->
    <!--
      One family (Roboto, the platform face), four roles. Letter spacing and
      weight do the hierarchy work, so nothing has to be loud.
    -->

    <style name="Text.Display" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <style name="Text.Secondary" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.005</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- small uppercase label above a value -->
    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ========================================================= widgets -->

    <style name="Widget.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Button.Action" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/on_action</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">54dp</item>
    </style>

    <style name="Widget.Button.Quiet" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_quiet</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <style name="Widget.Button.Link" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="Widget.Button.Icon" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_quiet</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Widget.Progress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_line</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>

    <style name="Widget.Progress.Thin" parent="Widget.Progress">
        <item name="android:minHeight">3dp</item>
        <item name="android:maxHeight">3dp</item>
    </style>

    <style name="CustomProgressBarStyle" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateTint">@color/text_secondary</item>
        <item name="android:indeterminateTintMode">src_in</item>
    </style>

    <style name="DarkAlertDialogStyle" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/action</item>
        <item name="android:windowMinWidthMinor">86%</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="AlertDialogStyle" parent="DarkAlertDialogStyle" />

</resources>
