<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
      Only what the loader actually does:

        INTERNET / ACCESS_NETWORK_STATE  → panel (key check + lib update)
        MANAGE_EXTERNAL_STORAGE          → read the game's OBB from shared storage
                                           before copying it into the sandbox
        READ/WRITE_EXTERNAL_STORAGE      → the same thing on Android ≤ 10
        WAKE_LOCK                        → held by the sandbox SDK while the game runs
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android 11+ package visibility: the loader only ever looks at BGMI, so a
      targeted <queries> replaces the QUERY_ALL_PACKAGES free-for-all.
    -->
    <queries>
        <package android:name="com.pubg.imobile" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".BoxApplication"
        android:allowBackup="false"
        android:icon="@drawable/logo_transparent"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Startup gate: the update is installed before anything else is reachable -->
        <activity
            android:name=".SplashActivity"
            android:configChanges="screenSize|orientation"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogAct"
            android:configChanges="screenSize|orientation"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".MAct"
            android:configChanges="screenSize|orientation"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".FacebookActivity"
            android:configChanges="screenSize|orientation"
            android:exported="false"
            android:theme="@style/AppTheme" />

    </application>

</manifest>
